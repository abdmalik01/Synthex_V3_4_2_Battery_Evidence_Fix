        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Conditions",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Outputs",
          "type": "array"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "experiment_id",
        "experiment_type"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "MaterialEntity": {
      "properties": {
