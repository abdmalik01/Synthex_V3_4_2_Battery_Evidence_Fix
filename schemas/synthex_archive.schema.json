        },
        "composition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Composition",
          "type": "object"
        },
        "elements": {
          "items": {
            "type": "string"
          },
          "title": "Elements",
          "type": "array"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "structure": {
          "additionalProperties": true,
          "title": "Structure",
          "type": "object"
        },
        "morphology": {
          "additionalProperties": true,
