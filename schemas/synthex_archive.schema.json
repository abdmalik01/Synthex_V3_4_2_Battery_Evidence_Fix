        "process_id",
        "name"
      ],
      "title": "ProcessStep",
      "type": "object"
    },
    "QualityRecord": {
      "properties": {
        "completeness": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        },
        "provenance_coverage": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Provenance Coverage",
          "type": "number"
        },
        "unit_normalization_coverage": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Unit Normalization Coverage",
          "type": "number"
        },
        "extraction_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Confidence"
        },
        "semantic_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Warnings",
          "type": "array"
        },
        "validation_status": {
          "default": "unvalidated",
          "description": "Validation stage. schema_validated means structural/local-schema checks passed; it does not imply scientific or human verification. machine_validated is retained only for backward-compatible archive reads.",
          "enum": [
            "unvalidated",
            "schema_validated",
            "machine_validated",
            "human_reviewed",
            "rejected"
          ],
          "title": "Validation Status",
          "type": "string"
        }
      },
      "title": "QualityRecord",
      "type": "object"
    },
    "Relationship": {
      "properties": {
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "subject_id",
        "predicate",
        "object_id"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "SourceRecord": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "default": "paper",
          "enum": [
            "paper",
            "dataset",
            "database",
            "report",
            "thesis",
            "patent",
            "user_upload"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
