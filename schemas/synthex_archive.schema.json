        },
        "material_ids": {
          "items": {
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "functional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
