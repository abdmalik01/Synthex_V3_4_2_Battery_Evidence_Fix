      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "domain_payloads": {
      "items": {
        "$ref": "#/$defs/DomainPayload"
      },
      "title": "Domain Payloads",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/QualityRecord"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "SynthexArchive",
  "type": "object"
}
