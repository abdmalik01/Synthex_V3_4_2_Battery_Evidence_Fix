      "properties": {
        "archive_id": {
          "title": "Archive Id",
          "type": "string"
        },
        "schema_name": {
          "default": "synthex-archive",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "default": "3.4.0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_version": {
          "default": "3.4.2",
          "title": "Software Version",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "generator": {
          "default": "Synthex V3.4.2",
          "title": "Generator",
          "type": "string"
        },
        "extractor_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Model"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "required": [
        "archive_id"
      ],
      "title": "ArchiveMetadata",
      "type": "object"
    },
    "CalculationRecord": {
      "properties": {
        "calculation_id": {
          "title": "Calculation Id",
          "type": "string"
