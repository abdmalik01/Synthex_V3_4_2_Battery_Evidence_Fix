    "ProcessStep": {
      "properties": {
        "process_id": {
          "title": "Process Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
