        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "text",
        "table",
        "figure",
        "figure_caption",
        "supplementary",
        "database",
        "computation",
        "user",
        "unknown"
      ],
      "title": "SourceType",
      "type": "string"
    }
