            "$ref": "#/$defs/Measurement"
          },
          "title": "Outputs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "calculation_id",
        "calculation_type"
      ],
      "title": "CalculationRecord",
      "type": "object"
    },
    "DeviceEntity": {
      "properties": {
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "device_type": {
          "title": "Device Type",
          "type": "string"
        },
        "material_ids": {
          "items": {
            "type": "string"
          },
          "title": "Material Ids",
          "type": "array"
        },
        "configuration": {
          "additionalProperties": true,
          "title": "Configuration",
