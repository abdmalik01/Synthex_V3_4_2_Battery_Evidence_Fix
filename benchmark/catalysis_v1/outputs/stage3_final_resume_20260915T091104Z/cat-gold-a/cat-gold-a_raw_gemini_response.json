  "preparations": [
    {
      "preparation_id": "prep_mmo",
      "name": "Coprecipitation and calcination",
      "ownership": "focal_work",
      "steps": [
        {
          "step": "mixing",
          "details": "Nitrates added gradually to sodium carbonate solution at 65 \u00b0C, stirred for 1 h and crystallized for 4 h.",
          "evidence": [
            {
              "page": 2,
              "section": "2.1. Hydrotalcite and mixed oxide synthesis",
              "text_snippet": "The respective nitrates were added gradually to sodium carbonate solution (JT Baker, 99.0 %) at 65 \u25e6C, without pH change to avoid problems of the crystalline structure formation. Once the nitrates were added, the solution was stirred for 1 h and crystallized for 4 h.",
              "source_type": "text",
              "original_source_type": "native_text",
              "verbatim_match": true
            }
          ]
        },
        {
          "step": "washing",
          "details": "Washed until neutral pH",
          "evidence": [
            {
              "page": 2,
              "section": "2.1. Hydrotalcite and mixed oxide synthesis",
              "text_snippet": "The resultant solid was washed until neutral pH",
              "source_type": "text",
              "original_source_type": "native_text",
              "verbatim_match": true
            }
          ]
        },
        {
          "step": "drying",
          "details": "Dried at 90 \u00b0C for 24 h",
          "evidence": [
            {
              "page": 2,
              "section": "2.1. Hydrotalcite and mixed oxide synthesis",
              "text_snippet": "and then dried at 90 \u25e6C for 24 h.",
              "source_type": "text",
              "original_source_type": "native_text",
              "verbatim_match": true
            }
          ]
        },
        {
          "step": "calcination",
          "details": "Calcined at 500 \u00b0C for 8 h",
          "evidence": [
            {
              "page": 2,
              "section": "2.1. Hydrotalcite and mixed oxide synthesis",
              "text_snippet": "To produce the MMOs, the synthesized HTs were calcined at 500 \u25e6C for 8 h.",
              "source_type": "text",
              "original_source_type": "native_text",
              "verbatim_match": true
            }
          ]
        }
      ]
    }
  ],
