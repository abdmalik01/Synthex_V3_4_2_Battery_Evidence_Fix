# Copy this file to .env and add your own keys. Never commit .env.
GEMINI_API_KEY=your_primary_gemini_api_key_here
# Optional production-only credential failover. Use keys from separate projects/accounts only where permitted.
# Synthex rotates to these only when an earlier credential hits quota/authentication failure.
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
# Set these only to exact IDs returned by the configured provider account's models.list API.
GEMINI_MODEL=
# Optional deterministic production failover order. Benchmark mode never uses it.
GEMINI_FALLBACK_MODELS=
SERPER_API_KEY=your_serper_api_key_here

SERPER_QUERY_BUDGET=2500

# Public single-server deployment only. Keep this mode off for local research.
SYNTHEX_PUBLIC_MODE=false
SYNTHEX_DATA_ROOT=/var/lib/synthex
SYNTHEX_DOMAIN=synthex.example.org
# Conservative, server-enforced daily provider-action limits.
SYNTHEX_PUBLIC_MAX_BATCH=3
SYNTHEX_PUBLIC_MAX_PDF_MB=25
SYNTHEX_PUBLIC_EXTRACTS_PER_USER_DAY=3
SYNTHEX_PUBLIC_EXTRACTS_GLOBAL_DAY=30
SYNTHEX_PUBLIC_SEARCHES_PER_USER_DAY=10
SYNTHEX_PUBLIC_SEARCHES_GLOBAL_DAY=100
