# Copy this file to .env and add your own keys. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional deterministic production failover order. Each fallback is attempted once.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash
SERPER_API_KEY=your_serper_api_key_here

SERPER_QUERY_BUDGET=2500
